# ── Server ────────────────────────────────────────────────
# Hosted PostgreSQL connection string (required for production)
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/crud_app_db?sslmode=require"

PORT=3001
NODE_ENV=development

# Allowed frontend origin for CORS (comma-separated or single URL).
# Set to your deployed Vercel URL in production, e.g. https://crud-app-sable-alpha.vercel.app
CORS_ORIGIN="*"

# ── Client ────────────────────────────────────────────────
# Leave as /api for local dev (uses Vite proxy) or set to your deployed API base
VITE_API_URL="/api"
